# =============================================================================
# AI-Worker Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- LLM Providers ---
ANTHROPIC_API_KEY=sk-ant-xxx
OLLAMA_HOST=http://localhost:11434
OLLAMA_KEEP_ALIVE=5m

# --- Vector Database (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=construction_knowledge

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_worker
POSTGRES_USER=ai_worker
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-worker

# --- Business System Integrations ---
JOBTREAD_API_KEY=
JOBTREAD_API_URL=https://api.jobtread.com/graphql

MORAWARE_API_KEY=
MORAWARE_API_URL=

QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:8080/callback
QB_ENVIRONMENT=sandbox

# --- Google Workspace ---
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json
GOOGLE_DRIVE_FOLDER_ID=

# --- Application Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Regional Cost Adjustments ---
DEFAULT_REGION=bend_or
LABOR_PREMIUM_FACTOR=1.10
